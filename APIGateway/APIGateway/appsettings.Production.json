{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "cl7F4MnVp24VCH6tkCBCZ9aHJbklPMZnV7jrP7gTO38=",
    "Issuer": "CurrencyTracker",
    "Audience": "CurrencyTrackerUsers",
    "ExpirationMinutes": 60
  },
  "Services": {
    "UserService": "http://userservice:8080/health",
    "FinanceService": "http://financeservice:8080/health"
  },
  "Api": {
    "Name": "Currency Tracker API",
    "Version": "1.0",
    "Description": "RESTful API for currency tracking and user management",
    "BasePath": "/api/v1",
    "DocumentationPath": "/api/v1/docs",
    "HealthPath": "/api/health"
  },
  "Cors": {
    "PolicyName": "AllowAll",
    "AllowAnyOrigin": true,
    "AllowAnyMethod": true,
    "AllowAnyHeader": true
  },
  "ReverseProxy": {
    "Routes": {
      "user-auth": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**remaining}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/auth"
          },
          {
            "PathPrefix": "/api/User"
          }
        ]
      },
      "currencies": {
        "ClusterId": "finance-service-cluster",
        "Match": {
          "Path": "/api/v1/currencies/{**remaining}"
        },
        "AuthorizationPolicy": "AuthenticatedUser",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/currencies"
          },
          {
            "PathPrefix": "/api/Finance/currencies"
          },
          {
            "RequestHeader": "X-User-Id",
            "Set": "{User:NameIdentifier}"
          },
          {
            "RequestHeader": "X-User-Name",
            "Set": "{User:Name}"
          }
        ]
      },
      "favorites": {
        "ClusterId": "finance-service-cluster",
        "Match": {
          "Path": "/api/v1/favorites/{**remaining}"
        },
        "AuthorizationPolicy": "AuthenticatedUser",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/favorites"
          },
          {
            "PathPrefix": "/api/Finance/favorites"
          },
          {
            "RequestHeader": "X-User-Id",
            "Set": "{User:NameIdentifier}"
          },
          {
            "RequestHeader": "X-User-Name",
            "Set": "{User:Name}"
          }
        ]
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://userservice:8080"
          }
        }
      },
      "finance-service-cluster": {
        "Destinations": {
          "finance-service": {
            "Address": "http://financeservice:8080"
          }
        }
      }
    }
  }
} 