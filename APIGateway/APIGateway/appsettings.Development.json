{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Application": {
    "Version": "1.0.0-dev",
    "Name": "Currency Tracker API Gateway"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-with-at-least-32-characters-for-development",
    "Issuer": "CurrencyTracker",
    "Audience": "CurrencyTrackerUsers",
    "ExpirationMinutes": 60
  },
  "Services": {
    "UserService": "http://userservice:8080/health",
    "FinanceService": "http://financeservice:8080/health"
  },
  "ReverseProxy": {
    "Routes": {
      "user-service": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/users"
          }
        ]
      },
      "finance-service": {
        "ClusterId": "finance-service-cluster",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/finance"
          }
        ]
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://userservice:8080"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "finance-service-cluster": {
        "Destinations": {
          "finance-service": {
            "Address": "http://financeservice:8080"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}
