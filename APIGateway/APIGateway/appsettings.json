{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Routing": "Debug",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "your-super-secret-key-with-at-least-32-characters",
    "Issuer": "CurrencyTracker",
    "Audience": "CurrencyTrackerUsers",
    "ExpirationMinutes": 60
  },
  "Services": {
    "UserService": "http://userservice:8080/health",
    "FinanceService": "http://financeservice:8080/health"
  },
  "ReverseProxy": {
    "Routes": {
      "user-service": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/users"
          },
          {
            "PathPrefix": "/api/User"
          }
        ]
      },
      "finance-service": {
        "ClusterId": "finance-service-cluster",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        },
        "AuthorizationPolicy": "AuthenticatedUser",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/finance"
          },
          {
            "PathPrefix": "/api/Finance"
          },
          {
            "RequestHeader": "X-User-Id",
            "Set": "{User:NameIdentifier}"
          },
          {
            "RequestHeader": "X-User-Name",
            "Set": "{User:Name}"
          }
        ]
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://userservice:8080"
          }
        }
      },
      "finance-service-cluster": {
        "Destinations": {
          "finance-service": {
            "Address": "http://financeservice:8080"
          }
        }
      }
    }
  }
}
